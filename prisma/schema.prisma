generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Product {
    id          String   @id @default(uuid())
    name        String
    description String   @db.LongText
    price       Int
    image       String
    category    String
    inStock     Int
    isDeleted   Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    Sales       Sales[]
}

model Sales {
    id        String      @id @default(uuid())
    salesId   String
    productId String
    qty       Int         @default(1)
    product   Product     @relation(fields: [productId], references: [id])
    status    SalesStatus @default(PENDING)
    name      String
    email     String?
    phone     String
    address   String
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
}

enum SalesStatus {
    PENDING
    APPROVED
    CANCELLED
}

model Payments {
    id                String      @id @default(uuid())
    salesId           String
    status            SalesStatus @default(PENDING)
    amount            Int         @default(0)
    merchantReference String
    orderTrackingId   String
    createdAt         DateTime    @default(now())
    updatedAt         DateTime    @updatedAt
}
